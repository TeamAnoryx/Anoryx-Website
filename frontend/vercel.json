{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.anoryxtechsolutions.com"
        }
      ],
      "destination": "https://anoryxtechsolutions.com/:path*",
      "permanent": true
    },
    {
      "source": "/solutions/privacy-first-ai",
      "destination": "/products/sentinel",
      "permanent": true
    },
    {
      "source": "/solutions/ai-infrastructure",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/solutions/autonomous-decision-systems",
      "destination": "/solutions",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
